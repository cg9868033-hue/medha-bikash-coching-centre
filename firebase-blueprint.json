        "fatherName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fatherNameBn": { "type": "string", "maxLength": 120 },
        "motherName": { "type": "string", "maxLength": 120 },
        "dob": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "address": { "type": "string", "maxLength": 300 },
        "guardianPhone": { "type": "string", "maxLength": 32 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "className": { "type": "string", "minLength": 1, "maxLength": 60 },
        "batchName": { "type": "string", "maxLength": 60 },
        "session": { "type": "string", "minLength": 2, "maxLength": 30 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["active", "pending", "suspended", "graduated"] },
        "enrolledCourseIds": { "type": "array" },
        "parentUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["admissionNo", "rollNo", "fullName", "fatherName", "classId", "className", "session", "status", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Madrasah Islamic education course or academic program",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "titleBn": { "type": "string", "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "categoryBn": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1200 },
        "descriptionBn": { "type": "string", "maxLength": 1200 },
        "level": { "type": "string", "maxLength": 60 },
        "duration": { "type": "string", "maxLength": 60 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "classId": { "type": "string", "maxLength": 128 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "featured", "status", "createdAt", "updatedAt"]
    },
    "ClassBatch": {
      "title": "ClassBatch",
      "description": "Academic class and batch configuration",
      "type": "object",
