        "paymentDate": { "type": "string", "maxLength": 40 },
        "remarks": { "type": "string", "maxLength": 300 },
        "recordedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNo", "studentId", "studentName", "category", "amount", "paidAmount", "dueAmount", "status", "recordedByUid", "createdAt", "updatedAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Editable Madrasah branding, homepage content, contact details, and grading scale",
      "type": "object",
      "properties": {
        "madrasaName": { "type": "string", "minLength": 2, "maxLength": 140 },
