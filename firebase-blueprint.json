        "motto": { "type": "string", "maxLength": 160 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroTitleBn": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 400 },
        "heroSubtitleBn": { "type": "string", "maxLength": 400 },
        "welcomeTitle": { "type": "string", "maxLength": 200 },
        "welcomeText": { "type": "string", "maxLength": 1500 },
        "welcomeTextBn": { "type": "string", "maxLength": 1500 },
        "aboutText": { "type": "string", "maxLength": 2000 },
        "aboutTextBn": { "type": "string", "maxLength": 2000 },
        "principalName": { "type": "string", "maxLength": 120 },
        "principalNameBn": { "type": "string", "maxLength": 120 },
        "principalTitle": { "type": "string", "maxLength": 120 },
        "principalMessage": { "type": "string", "maxLength": 1500 },
        "principalMessageBn": { "type": "string", "maxLength": 1500 },
        "principalPhotoUrl": { "type": "string", "maxLength": 500 },
        "principalPhotoPublicId": { "type": "string", "maxLength": 240 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "logoPublicId": { "type": "string", "maxLength": 240 },
        "heroBannerUrl": { "type": "string", "maxLength": 500 },
        "heroBannerPublicId": { "type": "string", "maxLength": 240 },
        "admissionBannerUrl": { "type": "string", "maxLength": 500 },
        "admissionBannerPublicId": { "type": "string", "maxLength": 240 },
        "certificateSealUrl": { "type": "string", "maxLength": 500 },
        "certificateSealPublicId": { "type": "string", "maxLength": 240 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "admissionOpen": { "type": "boolean" },
        "admissionBannerText": { "type": "string", "maxLength": 300 },
        "admissionBannerTextBn": { "type": "string", "maxLength": 300 },
        "address": { "type": "string", "maxLength": 300 },
        "addressBn": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 140 },
        "socialLinks": { "type": "object" },
        "gradingRules": { "type": "array" },
        "passPercentage": { "type": "number" },
        "superAdminInitialized": { "type": "boolean" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["madrasaName", "establishedYear", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administrative activity log",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
