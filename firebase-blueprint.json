        "uploadedAt": { "type": "string", "maxLength": 60 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "priority", "targetRole", "published", "authorUid", "authorName", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
