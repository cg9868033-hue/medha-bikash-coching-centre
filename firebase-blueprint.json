        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "targetCollection", "summary", "createdAt"]
    }
