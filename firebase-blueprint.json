{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Core user account and role-based access control profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "displayNameBn": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "teacher", "student", "parent"] },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "phone": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "permissions": { "type": "array", "description": "Granted granular permissions for admin/teacher" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "PublicTeacher": {
      "title": "PublicTeacher",
      "description": "Publicly visible scholar profile for the Madrasah homepage gallery (no PII)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameBn": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "titleBn": { "type": "string", "maxLength": 120 },
        "qualification": { "type": "string", "minLength": 1, "maxLength": 200 },
        "qualificationBn": { "type": "string", "maxLength": 200 },
        "experienceYears": { "type": "number" },
        "bio": { "type": "string", "maxLength": 1000 },
        "bioBn": { "type": "string", "maxLength": 1000 },
        "subjects": { "type": "array" },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "title", "qualification", "experienceYears", "featured", "order", "createdAt", "updatedAt"]
    },
    "TeacherRecord": {
      "title": "TeacherRecord",
      "description": "Internal teacher management profile with assignments and contact info",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherCode": { "type": "string", "minLength": 2, "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fullNameBn": { "type": "string", "maxLength": 120 },
        "qualification": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 1500 },
        "experience": { "type": "string", "maxLength": 120 },
        "subjects": { "type": "array" },
        "assignedCourseIds": { "type": "array" },
        "assignedClassIds": { "type": "array" },
        "assignedBatches": { "type": "array" },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryImageUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "uploadedAt": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "canPublishResults": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "teacherCode", "fullName", "qualification", "status", "canPublishResults", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Enrolled student academic and personal profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "admissionNo": { "type": "string", "minLength": 2, "maxLength": 40 },
        "rollNo": { "type": "string", "minLength": 1, "maxLength": 20 },
